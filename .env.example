# =========================================================
# projectstore.kunjdeveloper.me — production environment
# Copy this file to `.env` on the server and fill in values.
# Never commit the real `.env` file.
# =========================================================

# Public URLs (must match the NPM proxy host)
BASE_URL=https://projectstore.kunjdeveloper.me
ADMIN_BASE_URL=https://projectstore.kunjdeveloper.me/admin

# Application database (used by the PHP app)
DB_NAME=kunj_ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=replace-with-a-long-random-string

# MySQL root — only used for container init and healthcheck.
# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-string
