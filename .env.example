APP_PORT=8080
PHPMYADMIN_PORT=8091

# Leave these EMPTY for standalone Docker deployment (app served at root).
# Only set them if deploying behind a reverse proxy at a subdirectory.
# Example for subdirectory deployment:
#   BASE_URL=http://yourdomain.com/mystore
#   ADMIN_BASE_URL=http://yourdomain.com/mystore/admin
#   APP_BASE_PATH=/mystore
BASE_URL=
ADMIN_BASE_URL=
APP_BASE_PATH=

DB_NAME=kunj_ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=root_change_me
